# URecruitment environment variables: NAMES ONLY.
#
# Copy to .env.local (gitignored) and fill in the values locally.
# Never commit a value. This repository is public.
# Inventory and rules: docs/plans/infrastructure.md
#
# "server" means read only in server code (src/server/**, scripts). Never prefix these with NEXT_PUBLIC_.

# --- Supabase (server only) -------------------------------------------------
# Local: from `supabase status` for the local stack. Preview: dev project. Production: prod project.
SUPABASE_URL=
# SECRET. Bypasses Row Level Security. Server only.
SUPABASE_SECRET_KEY=

# --- AI (server only). The provider is not chosen yet (docs/decisions/adr-0003-ai-provider.md).
# Model ids per role. The provider API key name is added when the provider is decided.
AI_MODEL_PARSE=
AI_MODEL_MATCH=
AI_MODEL_GAP=
AI_MODEL_SEARCH=
AI_MODEL_JD=
AI_EMBED_MODEL=
# App-side monthly AI budget in USD.
AI_MONTHLY_SPEND_CAP=
# Score cap when a must-have requirement is missing (proposed default: 50).
MUST_HAVE_CAP=

# --- Monitoring ----------------------------------------------------------------
# A DSN is not a secret. It is optional locally.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Sample-data store: seed and eval scripts ONLY ----------------------------
# SECRET. Used only for list() on the public sample-data store. Never put/copy/del.
# App code under src/ must never read it.
BLOB_READ_WRITE_TOKEN=
# Treat as secret. The store's public base URL. NEVER commit it, paste it in an issue, or log it.
SEED_BLOB_BASE_URL=

# --- Tests ----------------------------------------------------------------------
# Optional. Base URL for Playwright (defaults to the local dev server).
PLAYWRIGHT_BASE_URL=
